# Appwrite client configuration (not secrets)
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_FLIGHT_SEARCH_FUNCTION_ID=flight-search

# DUFFEL_ACCESS_TOKEN belongs only in the Appwrite Function's Secret variables.
# Do not prefix the Duffel token with EXPO_PUBLIC_.
